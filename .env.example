# Copiar a .env (gitignored) y completar. Nunca commitear .env.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
ADMIN_API_KEY=
IP_HASH_SECRET=

# Modelos (ajustables sin tocar código)
CONVERSATION_MODEL=claude-haiku-5-5
SCORING_MODEL=claude-opus-5-5
TTS_PROVIDER=openai          # openai | piper
STT_PROVIDER=whisper_local   # whisper_local | openai
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda

# Avatar
AVATAR_MODE=mock             # mock | tavus  (tavus gasta minutos)
TAVUS_MAX_MINUTES_PER_SESSION=30

# App
APP_MODE=mock               # real permanece bloqueado hasta integrar proveedores y gates
PRIVACY_CONTACT=            # responsable real de solicitudes de borrado; no inventar
PUBLIC_BASE_URL=http://localhost:8000
DATA_DIR=./data
RETENTION_DAYS=30
INTERVIEW_MAX_MINUTES=30
