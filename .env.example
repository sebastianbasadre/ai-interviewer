# Copy to .env (gitignored) and fill in values. Never commit .env.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TAVUS_API_KEY=
TAVUS_FACE_ID=
# PAL created with pipeline_mode=echo to render Piper audio.
TAVUS_PAL_ID=
ADMIN_API_KEY=
IP_HASH_SECRET=

# Models (configurable without code changes)
CONVERSATION_MODEL=claude-haiku-5-5
CONVERSATION_ENABLED=false
# Persistent global API attempt limit; failures/timeouts also count.
CONVERSATION_MAX_CALLS=30
CONVERSATION_TIMEOUT_SECONDS=8
SCORING_MODEL=claude-opus-5-5
SCORING_ENABLED=false
SCORING_AUTO_GENERATE=true
# Each report reserves 3 attempts; 12 attempts allow up to 4 reports.
SCORING_MAX_CALLS=12
SCORING_TIMEOUT_SECONDS=45
TTS_PROVIDER=openai          # openai | piper
STT_PROVIDER=whisper_local   # whisper_local | openai
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda

# Avatar
AVATAR_MODE=mock             # mock | tavus  (Tavus consumes minutes)
TAVUS_MAX_MINUTES_PER_SESSION=30

# App
APP_MODE=mock               # real remains blocked pending provider integration and approval gates
PRIVACY_CONTACT=            # actual deletion-request owner; do not invent a contact
PUBLIC_BASE_URL=http://localhost:8000
# Private-LAN mock demo only; requires explicit network configuration.
ALLOW_MOCK_LAN_HTTP=false
DATA_DIR=./data
RETENTION_DAYS=30
INTERVIEW_MAX_MINUTES=30

# Optional local audio; install .[test,media] and configure LAN HTTPS.
REALTIME_ENABLED=false
PIPER_VOICE=es_AR-daniela-high
PIPER_ENGLISH_VOICE=en_GB-jenny_dioco-medium
MEDIA_MAX_MINUTES=3
LISTEN_PORT=8000
TLS_CERT_FILE=
TLS_KEY_FILE=
# Homelab TURN for WSL NAT traversal; shared secret with coturn.
TURN_URL=
TURN_SHARED_SECRET=
# Enable only after configuring keys and approving test minutes/cost.
TAVUS_ENABLED=false
